  </footer>

  <!-- Floating actions -->
  <div class="fixed bottom-24 right-4 z-40 hidden flex-col gap-2 sm:flex lg:bottom-6">
    <a href="https://wa.me/6281234567890?text=Halo%20Klinik%20Eunoia%2C%20saya%20ingin%20bertanya%20tentang%20layanan."
       target="_blank" rel="noopener noreferrer"
       class="grid h-12 w-12 place-items-center rounded-full bg-emerald-500 text-white shadow-lg transition hover:scale-105 hover:bg-emerald-600"
       aria-label="Hubungi Klinik Eunoia melalui WhatsApp">
      <i data-lucide="message-circle"></i>
    </a>

    <a href="tel:+62211234567"
       class="grid h-12 w-12 place-items-center rounded-full bg-primary text-white shadow-lg transition hover:scale-105 hover:bg-blue-700"
       aria-label="Telepon Klinik Eunoia">
      <i data-lucide="phone"></i>
    </a>

    <button id="back-top"
            type="button"
            class="hidden h-12 w-12 place-items-center rounded-full bg-darkblue text-white shadow-lg transition hover:scale-105"
            aria-label="Kembali ke atas">
      <i data-lucide="arrow-up"></i>
    </button>
  </div>

  <!-- Mobile sticky bottom CTA -->
  <div class="mobile-bottom fixed bottom-0 left-0 right-0 z-50 border-t border-slate-200 bg-white/95 p-2 backdrop-blur sm:hidden">
    <div class="grid grid-cols-3 gap-2">
      <a href="https://wa.me/6281234567890?text=Halo%20Klinik%20Eunoia%2C%20saya%20ingin%20bertanya."
         target="_blank" rel="noopener noreferrer"
         class="flex flex-col items-center justify-center gap-1 rounded-xl bg-emerald-50 py-2 text-[10px] font-bold text-emerald-700">
        <i data-lucide="message-circle" class="h-4 w-4"></i>
        WhatsApp
      </a>

      <a href="tel:+62211234567"
         class="flex flex-col items-center justify-center gap-1 rounded-xl bg-blue-50 py-2 text-[10px] font-bold text-primary">
        <i data-lucide="phone" class="h-4 w-4"></i>
        Telepon
      </a>

      <a href="#jadwal"
         class="flex flex-col items-center justify-center gap-1 rounded-xl bg-primary py-2 text-[10px] font-bold text-white">
        <i data-lucide="calendar-days" class="h-4 w-4"></i>
        Jadwal
      </a>
    </div>
  </div>

  <script>
    /* ============================
       Basic helpers
    ============================ */

    lucide.createIcons();

    function imageFallback(img) {
      img.onerror = null;
      img.src = 'data:image/svg+xml;charset=UTF-8,' + encodeURIComponent(`
        <svg xmlns="http://www.w3.org/2000/svg" width="800" height="500" viewBox="0 0 800 500">
          <rect width="800" height="500" fill="#EAF4FF"/>
          <g fill="none" stroke="#0B63CE" stroke-width="3">
            <circle cx="400" cy="220" r="70"/>
            <path d="M360 220h80M400 180v80"/>
          </g>
          <text x="400" y="340" text-anchor="middle" font-family="Arial" font-size="22" fill="#0A2A43">
            Klinik Eunoia
          </text>
        </svg>
      `);
    }

    /* ============================
       Mobile menu
    ============================ */

    const menuBtn = document.getElementById('menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');

    menuBtn.addEventListener('click', () => {
      const isOpen = !mobileMenu.classList.contains('hidden');

      mobileMenu.classList.toggle('hidden');
      menuBtn.setAttribute('aria-expanded', String(!isOpen));

      menuBtn.innerHTML = !isOpen
        ? '<i data-lucide="x" class="h-5 w-5"></i>'
        : '<i data-lucide="menu" class="h-5 w-5"></i>';

      lucide.createIcons();
    });

    document.querySelectorAll('.mobile-link').forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
        menuBtn.setAttribute('aria-expanded', 'false');
        menuBtn.innerHTML = '<i data-lucide="menu" class="h-5 w-5"></i>';
        lucide.createIcons();
      });
    });

    /* ============================
       Smooth scroll with header offset
    ============================ */

    document.querySelectorAll('a[href^="#"]').forEach(link => {
      link.addEventListener('click', event => {
        const targetId = link.getAttribute('href');

        if (!targetId || targetId === '#') return;

        const target = document.querySelector(targetId);
        if (!target) return;

        event.preventDefault();

        const headerHeight = document.getElementById('site-header').offsetHeight;
        const y = target.getBoundingClientRect().top + window.scrollY - headerHeight - 10;

        window.scrollTo({
          top: y,
          behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth'
        });

        history.replaceState(null, '', targetId);
      });
    });

    /* ============================
       Active navigation
    ============================ */

    const sections = document.querySelectorAll('main section[id]');
    const navLinks = document.querySelectorAll('.nav-link');

    const sectionObserver = new IntersectionObserver(
      entries => {
        entries.forEach(entry => {
          if (!entry.isIntersecting) return;

          navLinks.forEach(link => {
            link.classList.remove('text-primary');
            link.classList.add('text-slate-600');
          });

          const active = document.querySelector(`.nav-link[href="#${entry.target.id}"]`);

          if (active) {
            active.classList.remove('text-slate-600');
            active.classList.add('text-primary');
          }
        });
      },
      {
        rootMargin: '-35% 0px -55% 0px'
      }
    );

    sections.forEach(section => sectionObserver.observe(section));

    /* ============================
       Scroll reveal
    ============================ */

    const revealItems = document.querySelectorAll('.fade-up');

    if ('IntersectionObserver' in window) {
      const revealObserver = new IntersectionObserver(
        entries => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('show');
              revealObserver.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12 }
      );

      revealItems.forEach(item => revealObserver.observe(item));
    } else {
      revealItems.forEach(item => item.classList.add('show'));
    }

    /* ============================
       FAQ accordion
    ============================ */

    document.querySelectorAll('.faq-trigger').forEach(trigger => {
      trigger.addEventListener('click', () => {
        const item = trigger.closest('.faq-item');
        const isActive = item.classList.contains('active');

        document.querySelectorAll('.faq-item').forEach(other => {
          other.classList.remove('active');
          other.querySelector('.faq-trigger').setAttribute('aria-expanded', 'false');
        });

        if (!isActive) {
          item.classList.add('active');
          trigger.setAttribute('aria-expanded', 'true');
        }
      });
    });

    /* ============================
       Clinic open/closed status
       Senin-Sabtu 08:00-21:00
       Minggu 09:00-15:00
       IGD 24 jam
    ============================ */

    function updateOpenStatus() {
      const status = document.getElementById('open-status');
      const dot = document.getElementById('status-dot');

      const now = new Date();
      const day = now.getDay();
      const hour = now.getHours();
      const minute = now.getMinutes();
      const currentMinutes = hour * 60 + minute;

      let openMinutes;
      let closeMinutes;

      if (day === 0) {
        openMinutes = 9 * 60;
        closeMinutes = 15 * 60;
      } else {
        openMinutes = 8 * 60;
        closeMinutes = 21 * 60;
      }

      const isOpen = currentMinutes >= openMinutes && currentMinutes < closeMinutes;

      if (isOpen) {
        status.textContent = 'Sedang Buka';
        status.className = 'mt-1 text-lg font-extrabold text-emerald-600';
        dot.className = 'h-3 w-3 rounded-full bg-emerald-500';
      } else {
        status.textContent = 'Sedang Tutup · IGD 24 Jam';
        status.className = 'mt-1 text-lg font-extrabold text-slate-700';
        dot.className = 'h-3 w-3 rounded-full bg-slate-400';
      }
    }

    updateOpenStatus();
    setInterval(updateOpenStatus, 60000);

    /* ============================
       Booking form
    ============================ */

    const bookingForm = document.getElementById('booking-form');
    const dateInput = document.getElementById('date');

    const today = new Date();
    const todayISO = new Date(today.getTime() - today.getTimezoneOffset() * 60000)
      .toISOString()
      .split('T')[0];

    dateInput.min = todayISO;

    function showError(input, message) {
      const wrapper = input.parentElement;
      const error = wrapper.querySelector('.error-message');

      if (!error) return;

      error.textContent = message;
      error.classList.remove('hidden');
      input.classList.add('border-red-400', 'ring-4', 'ring-red-50');
    }

    function clearError(input) {
      const wrapper = input.parentElement;
      const error = wrapper.querySelector('.error-message');

      if (error) {
        error.textContent = '';
        error.classList.add('hidden');
      }

      input.classList.remove('border-red-400', 'ring-4', 'ring-red-50');
    }

    bookingForm.querySelectorAll('input, select, textarea').forEach(input => {
      input.addEventListener('input', () => clearError(input));
      input.addEventListener('change', () => clearError(input));
    });

    bookingForm.addEventListener('submit', event => {
      event.preventDefault();

      const name = document.getElementById('name');
      const phone = document.getElementById('phone');
      const date = document.getElementById('date');
      const service = document.getElementById('service');
      const doctor = document.getElementById('doctor');
      const complaint = document.getElementById('complaint');

      let valid = true;

      if (name.value.trim().length < 2) {
        showError(name, 'Masukkan nama lengkap Anda.');
        valid = false;
      }

      const cleanPhone = phone.value.replace(/[^\d+]/g, '');

      if (cleanPhone.length < 9) {
        showError(phone, 'Masukkan nomor WhatsApp yang valid.');
        valid = false;
      }

      if (!date.value) {
        showError(date, 'Pilih tanggal kunjungan.');
        valid = false;
      }

      if (!service.value) {
        showError(service, 'Pilih layanan yang dibutuhkan.');
        valid = false;
      }

      if (!valid) return;

      const formattedDate = new Intl.DateTimeFormat('id-ID', {
        day: '2-digit',
        month: 'long',
        year: 'numeric'
      }).format(new Date(`${date.value}T12:00:00`));

      const message =
`Halo Klinik Eunoia, saya ingin membuat janji.

Nama: ${name.value.trim()}
No. WhatsApp: ${phone.value.trim()}
Tanggal kunjungan: ${formattedDate}
Poli/Layanan: ${service.value}
Dokter: ${doctor.value || 'Tidak menentukan dokter'}
Keluhan/Kebutuhan: ${complaint.value.trim() || '-'}

Mohon dibantu konfirmasi ketersediaan jadwal. Terima kasih.`;

      const whatsappURL = `https://wa.me/6281234567890?text=${encodeURIComponent(message)}`;

      window.open(whatsappURL, '_blank', 'noopener,noreferrer');
    });

    /* ============================
       Testimonials
    ============================ */

    const track = document.getElementById('testimonial-track');
    const slides = document.querySelectorAll('.testimonial-slide');
    const prevBtn = document.getElementById('prev-testimonial');
    const nextBtn = document.getElementById('next-testimonial');

    let testimonialIndex = 0;
    let testimonialTimer;

    function visibleTestimonials() {
      return window.innerWidth >= 1024 ? 3 : 1;
    }

    function updateTestimonials() {
      const visible = visibleTestimonials();
      const maxIndex = Math.max(0, slides.length - visible);

      testimonialIndex = Math.min(testimonialIndex, maxIndex);

      const percentage = 100 / visible;
      track.style.transform = `translateX(-${testimonialIndex * percentage}%)`;
    }

    function nextTestimonial() {
      const visible = visibleTestimonials();
      const maxIndex = Math.max(0, slides.length - visible);

      testimonialIndex = testimonialIndex >= maxIndex ? 0 : testimonialIndex + 1;
      updateTestimonials();
    }

    function previousTestimonial() {
      const visible = visibleTestimonials();
      const maxIndex = Math.max(0, slides.length - visible);

      testimonialIndex = testimonialIndex <= 0 ? maxIndex : testimonialIndex - 1;
      updateTestimonials();
    }

    prevBtn.addEventListener('click', previousTestimonial);
    nextBtn.addEventListener('click', nextTestimonial);

    function startTestimonialTimer() {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      clearInterval(testimonialTimer);
      testimonialTimer = setInterval(nextTestimonial, 5500);
    }

    startTestimonialTimer();
    updateTestimonials();

    document.getElementById('testimonial-slider').addEventListener('mouseenter', () => {
      clearInterval(testimonialTimer);
    });

    document.getElementById('testimonial-slider').addEventListener('mouseleave', () => {
      startTestimonialTimer();
    });

    window.addEventListener('resize', updateTestimonials);

    /* ============================
       Back to top
    ============================ */

    const backTop = document.getElementById('back-top');

    window.addEventListener('scroll', () => {
      if (window.scrollY > 500) {
        backTop.classList.remove('hidden');
        backTop.classList.add('grid');
      } else {
        backTop.classList.add('hidden');
        backTop.classList.remove('grid');
      }
    }, { passive: true });

    backTop.addEventListener('click', () => {
      window.scrollTo({
        top: 0,
        behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth'
      });
    });

    /* ============================
       Prevent broken hash-only links
    ============================ */

    document.querySelectorAll('a[href="#"]').forEach(link => {
      link.addEventListener('click', event => event.preventDefault());
    });
  </script>

</body>
</html>
